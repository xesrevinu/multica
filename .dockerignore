# Dependencies
node_modules
.pnpm-store

# Build outputs — list the web cache path after !/apps/web/ too (below)
# so it stays excluded when that directory is re-included.
.next
**/.next
**/.turbo
**/*.tsbuildinfo
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Dockerfile.web needs the web workspace and root dependency patch inputs.
# Default-exclude other app files so they do not enter the build context.
/apps/*
!/apps/web/
!/apps/mobile/
/apps/mobile/*
# The root lockfile's patchedDependencies hash this patch while installing the
# web workspace, so the one directory has to stay in the build context.
!/apps/mobile/patches/
apps/web/.next
apps/web/.next/**
apps/web/node_modules
apps/web/*.tsbuildinfo

# Repository-only tooling
/.github/
/deploy/
/scripts/
