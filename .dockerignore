# Dependencies
node_modules
.pnpm-store

# Build outputs — list the web cache path after !/apps/web/ too (below)
# so it stays excluded when that directory is re-included.
.next
**/.next
**/.turbo
**/*.tsbuildinfo
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Dockerfile.web needs only the web workspace from apps/.
# Default-exclude other app files so they do not enter the build context.
/apps/*
!/apps/web/
apps/web/.next
apps/web/.next/**
apps/web/node_modules
apps/web/*.tsbuildinfo
# Host `pnpm --filter @multica/web build` output. `dist` above ignores every
# dist directory; this exception is later, so it wins.
!apps/web/dist/
!apps/web/dist/**

# Repository-only tooling
/.github/
/deploy/
/scripts/
