{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@multica/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "multica-tui": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui/run.tsx"
  },
  "scripts": {
    "start": "bun run src/bin.ts",
    "dev": "bun --watch run src/bin.ts",
    "generate": "bun run script/generate.ts",
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt --check .",
    "test:e2e": "bun run script/e2e.ts"
  },
  "dependencies": {
    "@multica/core": "workspace:*",
    "@opentui/core": "^0.6.6",
    "@opentui/keymap": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "@tanstack/react-query": "catalog:",
    "effect": "catalog:",
    "fuzzysort": "^3.1.0",
    "jsonc-parser": "3.3.1",
    "react": "catalog:",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@effect/openapi-generator": "4.0.0-rc.112",
    "@effect/platform-node": "catalog:",
    "@types/bun": "^1.3.0",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "optionalDependencies": {
    "react-devtools-core": "^7.0.1"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  },
  "peerDependenciesMeta": {
    "react-devtools-core": {
      "optional": true
    }
  }
}
