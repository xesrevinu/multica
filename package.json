{
  "name": "multica",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "turbo dev --filter=@multica/web",
    "build": "turbo build",
    "typecheck": "node scripts/assert-tsrs.mjs && turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "fmt": "turbo fmt",
    "knip": "knip",
    "check:ui-exports": "node scripts/check-ui-wildcard-exports.mjs",
    "check:ui-radii": "node scripts/check-ui-radius-tokens.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add",
    "generate:reserved-slugs": "node scripts/generate-reserved-slugs.mjs",
    "dev:tui": "turbo dev --filter=@multica/tui",
    "start:tui": "pnpm --filter @multica/tui start"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": ">=4.8.4 <8"
      }
    },
    "packageExtensions": {
      "knip": {
        "dependencies": {
          "typescript": "npm:@typescript/typescript6@^6.0.2"
        }
      }
    },
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "react": "catalog:",
      "react-dom": "catalog:",
      "react-server-dom-webpack": "catalog:",
      "scheduler": "0.28.0",
      "@xmldom/xmldom": "^0.8.13",
      "postcss": "8.5.26",
      "uuid": "11.1.1",
      "shell-quote": "1.9.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@5>brace-expansion": "2.1.4",
      "minimatch@9>brace-expansion": "2.1.4",
      "minimatch@10>brace-expansion": "5.0.9",
      "builder-util-runtime": "9.7.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@typescript/typescript6": "catalog:",
    "js-yaml": "^4.1.1",
    "knip": "^6.32.3",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pg": "^8.20.0",
    "turbo": "^2.10.12",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
