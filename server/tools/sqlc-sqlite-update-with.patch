+
+func sqliteWithClause(c *cc, n interface{}) *ast.WithClause {
+	type withSrc interface {
+		With_clause() parser.IWith_clauseContext
+	}
+	src, ok := n.(withSrc)
+	if !ok || src.With_clause() == nil {
+		return nil
+	}
+	ct := src.With_clause()
+	var ctes ast.List
+	recursive := ct.RECURSIVE_() != nil
+	names := ct.AllCte_table_name()
+	selects := ct.AllSelect_stmt()
+	for i, name := range names {
+		if i >= len(selects) {
+			break
+		}
+		tableName := identifier(name.GetText())
+		ctes.Items = append(ctes.Items, &ast.CommonTableExpr{
+			Ctename:      &tableName,
+			Ctequery:     c.convert(selects[i]),
+			Location:     name.GetStart().GetStart(),
+			Cterecursive: recursive,
+		})
+	}
+	if len(ctes.Items) == 0 {
+		return nil
+	}
+	return &ast.WithClause{Ctes: &ctes}
+}
