# The web program is built on the host or CI runner (`pnpm --filter @multica/web build`).
# That produces a platform-matching Bun executable at apps/web/dist/server/multica-web
# plus static assets under apps/web/dist/client. React is inside the executable.
# This image does not compile and does not install Node.

FROM debian:bookworm-slim AS runner
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 web \
  && useradd --system --uid 1001 --gid web --home-dir /app web

ENV NODE_ENV=production
ENV REMOTE_API_URL=http://backend:8080
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --chown=web:web apps/web/dist ./dist
COPY --chown=web:web LICENSE NOTICE ./

USER web
EXPOSE 3000
CMD ["/app/dist/server/multica-web"]
