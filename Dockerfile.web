# The web program is built on the host (`pnpm --filter @multica/web build`)
# and copied in. Docker only installs the Linux runtime packages pinned in
# dist/runtime-package.json, so image builds stay small.

FROM node:22-alpine AS runtime-deps
WORKDIR /app
COPY apps/web/dist/runtime-package.json ./package.json
RUN npm install --omit=dev

# node:22-alpine is ~150MB because it ships npm/yarn/headers. The server
# only needs the node binary + libstdc++.
FROM node:22-alpine AS nodebin
FROM alpine:3.24 AS runner

WORKDIR /app

# Alpine openssl security fixes (CVE-2026-63073, CVE-2026-75803).
# Floor pins the fix so the build fails instead of silently shipping the CVEs.
# Remove once node:22-alpine includes libssl3 >= 3.5.8-r0.
RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"

ENV NODE_ENV=production
ENV REMOTE_API_URL=http://backend:8080

RUN apk add --no-cache libstdc++ && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=nodebin /usr/local/bin/node /usr/local/bin/node

# serve-node.mjs binds HOST (default 0.0.0.0), not Next's HOSTNAME.
COPY --from=runtime-deps --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --chown=nextjs:nodejs apps/web/dist ./dist
# Ship the license and attribution notices with the image (LICENSE condition 1b)
COPY --chown=nextjs:nodejs LICENSE NOTICE ./

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOST=0.0.0.0

CMD ["node", "dist/server/serve-node.mjs"]
