# The web program is built on the host or CI runner (`pnpm --filter @multica/web build`).
# That produces a platform-matching Bun executable at apps/web/dist/server/multica-web
# plus static assets under apps/web/dist/client. React is inside the executable.
# This image does not compile and does not install Node.

# The executable links only glibc (libc, libm, libpthread, libdl), so a
# distroless glibc base with CA certificates is enough: no shell, no package
# manager, ~90 MB smaller than debian:bookworm-slim. Runs as uid 65532.
FROM gcr.io/distroless/base-debian12:nonroot AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV REMOTE_API_URL=http://backend:8080
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --chown=nonroot:nonroot apps/web/dist ./dist
COPY --chown=nonroot:nonroot LICENSE NOTICE ./

USER nonroot
EXPOSE 3000
CMD ["/app/dist/server/multica-web"]
